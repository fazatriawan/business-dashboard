# ── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional (for Multi-Agent LLM Orchestration) ─────────────────────────────
# Claude (Anthropic) - for deep reasoning / drill-down tasks
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Kimi (Moonshot AI) - for conversational UI / briefing tasks
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-8k

# AI Priority Order (comma-separated): gemini,claude,kimi
AI_PRIORITY=gemini,claude,kimi

# ── Optional (for Google Sheets API v4 - if you want worksheet listing) ──────
# GOOGLE_SHEETS_API_KEY=your_google_api_key_here
